# --- MangaBox analitika backendi (bot-mangabox) ---
# Panel shu backenddan o'qiydi. Brauzer bu manzilga to'g'ridan-to'g'ri bormaydi:
# barcha so'rovlar `/api/backend/*` server proksisi orqali o'tadi.
MANGABOX_API_URL=http://localhost:3111

# Ixtiyoriy: login oqimisiz ishlash uchun tayyor admin token
# (`POST /api/admin/auth/login` javobidagi `token`). Odatda kerak emas —
# kirish paytida token httpOnly cookie ga yoziladi.
# MANGABOX_ADMIN_TOKEN=

# Ommaviy origin (canonical URL, sitemap, robots uchun).
NEXT_PUBLIC_SITE_URL=https://volar.uz
